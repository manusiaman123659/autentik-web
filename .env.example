# ==============================================================================
# Environment Configuration - PT Autentik Karya Analitika
# ==============================================================================
# Salin file ini menjadi .env.local:
#   cp .env.example .env.local
# dan sesuaikan nilainya dengan kredensial proyek Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Wajib untuk database, auth, & storage)
# ------------------------------------------------------------------------------
# Dapatkan dari Supabase Dashboard: Project Settings > API. Nilai URL harus
# menunjuk ke project Supabase yang dipakai oleh target deployment/build.
# Vercel Preview dan Production harus menerima nilai environment yang benar
# sebelum build karena konfigurasi client dan next/image dibekukan saat build.
NEXT_PUBLIC_SUPABASE_URL=https://edfzuzqxxynbycwrfuoe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sa2OWmxbF14fFH6TLDBR5A_ceQPCPE5
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Site URL
# ------------------------------------------------------------------------------
# Contoh di bawah hanya untuk development lokal. Deployment wajib mengisi origin
# publik HTTPS yang sebenarnya saat Docker image dibangun (NEXT_PUBLIC_* build-time).
# Callback OAuth production: <NEXT_PUBLIC_SITE_URL>/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Google Gemini AI (Opsional: Chatbot AI di /api/chat + draf terjemahan produk B2B)
# ------------------------------------------------------------------------------
# Dapatkan dari Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 4. Midtrans Payment Gateway (Opsional: transaksi e-commerce checkout)
# ------------------------------------------------------------------------------
# Dapatkan dari Dashboard Midtrans (Sandbox / Production)
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 5. Mika Career REST API (Backend Recruitment Laravel)
# ------------------------------------------------------------------------------
# Server-only. Tidak ada fallback otomatis; ngrok hanya untuk development eksplisit.
# Sebelum production launch, gunakan URL HTTPS permanen MIKA Careers dan perbarui
# juga site_settings.recruitment. Integrasi Career dapat belum lengkap saat uji Vercel.
MIKA_API_BASE_URL=

# ------------------------------------------------------------------------------
# 6. MIKA Product Sync API (server-to-server, inbound ke AKA)
# ------------------------------------------------------------------------------
# Gunakan secret acak berentropi tinggi. Jangan gunakan prefix NEXT_PUBLIC_.
MIKA_INTEGRATION_SECRET=

# Server-only. Aktifkan hanya setelah migration 0069 diterapkan dan RPC publik
# search_store_products_v1 berhasil diverifikasi pada database deployment.
STORE_SEARCH_RPC_ENABLED=false

# ------------------------------------------------------------------------------
# 7. Customer Password Recovery (server-only)
# ------------------------------------------------------------------------------
# Secret HMAC minimal 32 karakter. Jangan gunakan prefix NEXT_PUBLIC_.
CUSTOMER_RECOVERY_TOKEN_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Opsional untuk mock lokal; production wajib memakai endpoint HTTPS default.
RESEND_API_URL=
